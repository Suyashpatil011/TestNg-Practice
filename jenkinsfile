pipeline {
    agent any

    tools {
        jdk 'Java21'
        maven 'Maven3'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git(
                    branch: 'jenkins-fix',
                    url: 'https://github.com/Suyashpatil011/TestNg-Practice.git'
                )
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }



    post {
        success {
            emailext(
                subject: "✅ Build Passed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """All tests passed successfully.
Check reports here: ${env.BUILD_URL}artifact/target/surefire-reports/
""",
                to: 'suyashpatil0100@gmail.com'
            )
        }

        failure {
            emailext(
                subject: "❌ Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Build failed.
Check console output: ${env.BUILD_URL}console
""",
                to: 'suyashpatil0100@gmail.com'
            )
        }
    }
}
